# App
APP_NAME=go-cloud-file-storage
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgresql://admin:secret123@localhost:5432/db
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_SSL_MODE=disable
# Redis
REDIS_PASSWORD=secret123
# Session configuration
SESSION_TTL=24h
SESSION_CLEANUP_INTERVAL=12h
# Tracing
TRACING_ENABLED=true
TRACING_OTLP_ENDPOINT=localhost:4317
TRACING_OTLP_INSECURE=true
# DON'T set to 1.0 in production, use a lower value like 0.1 or 0.01
TRACING_SAMPLE_RATE=1.0

