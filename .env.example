# App
APP_NAME=go-cloud-file-storage
APP_VERSION=1.0.0
# HTTP settings
HTTP_PORT=8080
# Logger
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgresql://admin:secret123@localhost:5432/db
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_SSL_MODE=disable
